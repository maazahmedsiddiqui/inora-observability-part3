  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**Assignment 3 - load balancing across replicas A, B, C.** Test traffic is read-only: HTTP `GET /products/{id}` (`app_*` metrics) and gRPC `CatalogService/GetProduct` (`grpc_server_*` metrics), both sent through Envoy.\n\n* **Colours:** A = blue, B = orange, C = green on every panel. The `replica` label is attached by Prometheus' scrape config (one target per replica; Prometheus scrapes A, B, C and Envoy directly, never through Envoy's balanced route).\n* **Time window:** all rates and percentiles use a **30s** window (`rate(...[30s])`; Prometheus scrapes every 5 s). Panels lag the real traffic by about that much.\n* **Share** = replica rate / sum of all replica rates. **Active requests** = in-flight, sampled every 5 s. **p50/p95** are server-side, from histograms.\n* **Envoy row** shows what the proxy sees: requests per cluster, responses by class (2xx/5xx), and how many replicas Envoy currently considers healthy."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "HTTP - per replica (A, B, C)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP: request rate per replica (req/s, 30s window)",
      "description": "Requests per second answered by each replica, from the replicas' own metrics. Idle replicas show 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (replica) (rate(app_requests_total{job=\"inora_backend\", endpoint=\"/products/<product_id>\"}[30s])) or (sum by (replica) (up{job=\"inora_backend\"}) * 0)",
          "legendFormat": "{{replica}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^A( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^B( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^C( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
