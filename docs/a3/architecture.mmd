flowchart TB
    client["Test client<br/>HTTP :10000 &nbsp;|&nbsp; gRPC :10001"]
    envoy["<b>Envoy v1.39.1</b><br/>HTTP listener :10000<br/>gRPC listener :10001 (HTTP/2)<br/>admin + metrics :9901"]

    subgraph http["HTTP API replicas &nbsp;(Flask :5000)"]
